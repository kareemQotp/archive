rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    /************************************************************
     * وظائف مساعدة عامة (Helper Functions)
     * يتم التركيز هنا على:
     * - التحقق من حالة التسجيل
     * - جلب الدور (role) للمستخدم الحالي
     * - أدوار النظام (admin / archive_officer)
     * - منع ترقية الصلاحيات غير المصرح بها
     ************************************************************/

    // التحقق من أن المستخدم مسجل دخول
    function isAuthenticated() {
      return request.auth != null;
    }

    // جلب مستند المستخدم الحالي بصورة آمنة (قد يرجع null لو غير موجود)
    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // الدور الحالي للمستخدم
    function getUserRole() {
      return currentUserDoc().data.role;
    }

    // هل الدور الحالي يعادل دور admin؟ (توافق مرحلي)
    function isAdminRole(role) {
      return role in ['admin', 'system_admin', 'super_admin'];
    }

    // هل الدور الحالي يعادل دور archive officer؟ (توافق مرحلي)
    function isArchiveOfficerRole(role) {
      return role in ['archive_officer', 'archive-officer'];
    }

    // هل المستخدم إداري؟ (يدعم admin و system_admin)
    function isAdmin() {
      return isAuthenticated() && isAdminRole(getUserRole());
    }

    // صلاحيات الإدارة الحساسة محصورة على super_admin/system_admin
    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() in ['super_admin', 'system_admin'];
    }

    // السماح بترقية ذاتية محدودة لحسابات إدارية موثوقة (bootstrap)
    function isTrustedAdminBootstrap() {
      return isAuthenticated() &&
        request.auth.token.email != null &&
        (request.auth.token.email == 'admin@aman.eg' || request.auth.token.email == 'admin123@aman.eg');
    }

    // هل المستخدم موظف أرشيف؟ (يدعم الكتابة بالشرطة أو الشرطة السفلية)
    function isArchiveOfficer() {
      return isAuthenticated() && isArchiveOfficerRole(getUserRole());
    }

    // هل هو المالك أو إداري؟
    function isOwnerOrAdmin(userId) {
      return isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // السماح فقط للأدوار المحددة (توسيع لدعم أدوار الواجهة)
    function isAllowedRole(role) {
      return role in [
        'admin', 'system_admin', 'super_admin',
        'department_admin', 'department-admin',
        'manager', 'supervisor', 'employee',
        'archive_officer', 'archive-officer',
        'legal', 'governance', 'collection', 'securitization',
        'user', 'viewer'
      ];
    }

    // التحقق من عدم تغيير الدور من قبل مستخدم ليس إداري
    function roleNotElevatedOnUserUpdate() {
      return !('role' in request.resource.data) ||
             ((isAdmin() || isTrustedAdminBootstrap()) && isAllowedRole(request.resource.data.role)) ||
             request.resource.data.role == resource.data.role ||
             // السماح بترقية أولية من viewer/user إلى admin لحساب موثوق فقط مرة واحدة
             (
               isTrustedAdminBootstrap() &&
               resource.data.role in ['viewer','user'] &&
               request.resource.data.role == 'admin'
             );
    }

    /************************************************************
     * دوال التحقق من الحقول (Field Validation)
     ************************************************************/
    // التحقق من الحقول المسموحة في مستند المستخدم عند الإنشاء/التحديث
  function userAllowedKeys(keys) {
      // السماح بحقول الملف الشخصي الشائعة والتتبع الذاتي (آخر دخول وعدد الدخول)
      // بالإضافة إلى الحقول المستخدمة من واجهة الإدارة الحالية
      return keys.hasOnly([
        'uid',
        'displayName', 'firstName', 'lastName', 'fullName',
        'email', 'emailVerified',
        'role', // محمي عبر roleNotElevatedOnUserUpdate
        'createdAt', 'updatedAt', 'createdBy', 'updatedBy',
        'department', 'departmentId', 'departmentName',
        'disabled', 'isActive',
        'photoURL', 'profilePicture', 'phone', 'bio',
        'settings', 'permissions',
        'registrationType', 'joinReason', 'inviteCode', 'invitedBy',
        'lastLogin', 'loginCount', 'lastActivity',
        // دعم مفاتيح إضافية يستخدمها لوحة الإدارة
        'status', // متروك للتوافق مع سجلات قديمة، لن يُستخدم مستقبلاً
        'archived', 'isArchived', 'archivedAt',
        'phoneNumber',
        // تواريخ/حقول سير العمل الإداري
        'approvedAt', 'approvedBy', 'rejectedAt', 'rejectedBy',
        'roleAssignedAt', 'roleAssignedBy',
        // حقول المزامنة والإضافة السريعة
        'syncedFromAuth', 'syncedAt', 'syncedBy',
        'manuallyAdded', 'quickAdded', 'addedAt', 'addedBy'
      ]);
    }

    // الحقول المسموحة في مستند الوثيقة
    function documentAllowedKeys(keys) {
      return keys.hasOnly([
        // وصف عام
        'title', 'description', 'status', 'tags', 'category', 'isActive',
        // التعريف بالقسم
        'department', 'departmentId', 'currentDepartment',
        // ربط العميل وملف العميل
        'clientId', 'clientName', 'clientFileId',
        'nationalId', 'contractNumber', 'caseNumber',
        // تتبع الباركود
        'barcode', 'qrCode',
        // بيانات الإنشاء والتتبع
        'createdBy', 'createdAt', 'updatedAt',
        // ربط التخزين والتحميل
        'fileName', 'filePath', 'downloadURL', 'fileSize', 'contentType', 'uploadedAt',
        // مصغرات الصور
        'hasThumbnail', 'thumbnailPath'
      ]);
    }

    // الحقول المسموحة في مستند العميل
    function clientAllowedKeys(keys) {
      return keys.hasOnly([
        'name', 'nameNormalized',
        'clientId', 'nationalId',
        'phone', 'email', 'notes',
        'status', 'isActive',
        'createdBy', 'createdAt', 'updatedAt'
      ]);
    }

    // الحقول المسموحة في مستند ملف العميل
    function clientFileAllowedKeys(keys) {
      return keys.hasOnly([
        'clientRef', 'clientId', 'clientName',
        'fileNumber', 'barcode',
        'nationalId', 'contractNumber', 'caseNumber',
        'status', 'currentHolder', 'locked',
        'requestType', 'lastTransitionBy', 'lastTransitionAt',
        'notes',
        'createdBy', 'createdAt', 'updatedAt'
      ]);
    }

    // الحالات المسموحة لملف العميل
    function isAllowedClientFileStatus(value) {
      return value in [
        'archived', 'requested', 'transferred',
        'in_legal', 'in_collection',
        'digital_shared', 'returned'
      ];
    }

    // الأقسام/الجهات المسموحة لحيازة الملف
    function isAllowedHolder(value) {
      return value in ['archive', 'legal', 'collection', 'governance', 'securitization', 'bank'];
    }

    // هل الانتقال بين حالتين صالح وفق state machine؟
    function isValidClientFileStatusTransition(oldStatus, newStatus) {
      return oldStatus == newStatus ||
        (oldStatus == 'archived' && newStatus in ['requested', 'digital_shared']) ||
        (oldStatus == 'requested' && newStatus in ['transferred', 'archived']) ||
        (oldStatus == 'transferred' && newStatus in ['in_legal', 'in_collection', 'returned']) ||
        (oldStatus == 'in_legal' && newStatus in ['returned', 'digital_shared']) ||
        (oldStatus == 'in_collection' && newStatus in ['returned', 'digital_shared']) ||
        (oldStatus == 'digital_shared' && newStatus in ['archived', 'requested']) ||
        (oldStatus == 'returned' && newStatus == 'archived');
    }

    // التحقق من منطق القفل: إذا خرج الأصل من archive يصبح locked=true
    function isValidClientFileLockState() {
      // الطلب الرقمي لا يخرج الأصل من الأرشيف ويجب أن يبقى دون قفل
      let digitalRule = !('requestType' in request.resource.data) ||
        request.resource.data.requestType != 'digital' || (
          request.resource.data.status == 'digital_shared' &&
          request.resource.data.currentHolder == 'archive' &&
          request.resource.data.locked == false
        );

      // الحالة requested لا تُسمح إلا داخل الأرشيف وبدون قفل
      let requestedRule = request.resource.data.status != 'requested' || (
        request.resource.data.currentHolder == 'archive' &&
        request.resource.data.locked == false
      );

      // الحالات التشغيلية خارج الأرشيف يجب أن تكون مقفلة
      let outOfArchiveOperationalRule =
        !(request.resource.data.status in ['transferred', 'in_legal', 'in_collection']) ||
        (request.resource.data.currentHolder != 'archive' && request.resource.data.locked == true);

      // حالات الإرجاع/الأرشفة يجب أن تنتهي داخل الأرشيف وبدون قفل
      let archiveEndStateRule =
        !(request.resource.data.status in ['returned', 'archived']) ||
        (request.resource.data.currentHolder == 'archive' && request.resource.data.locked == false);

      return (
        request.resource.data.currentHolder == 'archive' ||
        request.resource.data.locked == true
      ) && (
        !('requestType' in request.resource.data) ||
        request.resource.data.requestType in ['physical', 'digital']
      ) && digitalRule && requestedRule && outOfArchiveOperationalRule && archiveEndStateRule;
    }

    // شروط إنشاء ملف العميل في الحالة الابتدائية
    function isValidClientFileCreateState() {
      return isAllowedClientFileStatus(request.resource.data.status) &&
        isAllowedHolder(request.resource.data.currentHolder) &&
        request.resource.data.status == 'archived' &&
        request.resource.data.currentHolder == 'archive' &&
        request.resource.data.locked == false;
    }

    // شروط تحديث ملف العميل حسب state machine
    function isValidClientFileUpdateState() {
      return isAllowedClientFileStatus(request.resource.data.status) &&
        isAllowedHolder(request.resource.data.currentHolder) &&
        isValidClientFileStatusTransition(resource.data.status, request.resource.data.status) &&
        isValidClientFileLockState();
    }

    // الحقول المسموحة في حركة الملف (مطابقة لما يتم إرساله من الواجهة)
    function movementAllowedKeys(keys) {
      return keys.hasOnly([
        'fileNumber',
        'clientFileId',
        'fileName',
        'fromDepartment',
        'toDepartment',
        'action',
        'status',
        'requestType',
        'priority',
        'condition',
        'scanMethod',
        'notes',
        'userId',
        'userEmail',
        'userDisplayName',
        'timestamp'
      ]);
    }

    // الحقول المسموحة في طلب التحويل
    function transferRequestAllowedKeys(keys) {
      return keys.hasOnly([
        'requestType',
        'clientFileId', 'fileNumber',
        'fromDepartment', 'toDepartment',
        'status', 'notes',
        'createdBy', 'createdByName', 'createdAt',
        'reviewedBy', 'reviewedByName', 'reviewedAt', 'reviewNotes',
        'shareToken', 'shareUrl', 'shareExpiresAt',
        'updatedAt'
      ]);
    }

    function transferRequestStatusUnchanged() {
      return request.resource.data.status == resource.data.status;
    }

    function isWorkflowReviewer() {
      return isAdmin() || isArchiveOfficer() ||
        (isAuthenticated() && getUserRole() in ['department_admin', 'department-admin', 'manager', 'supervisor']);
    }

    function isAllowedTransferRequestStatus(value) {
      return value in ['pending', 'approved', 'rejected', 'dispatched', 'received', 'returned', 'completed'];
    }

    function isValidTransferRequestTransition(oldStatus, newStatus) {
      return oldStatus == newStatus ||
        (oldStatus == 'pending' && newStatus in ['approved', 'rejected']) ||
        (oldStatus == 'approved' && newStatus in ['dispatched', 'completed']) ||
        (oldStatus == 'dispatched' && newStatus == 'received') ||
        (oldStatus == 'received' && newStatus == 'returned');
    }

    function isValidTransferRequestStateOnCreate() {
      return request.resource.data.status == 'pending' &&
        request.resource.data.requestType in ['physical', 'digital'];
    }

    function isValidTransferRequestStateOnUpdate() {
      return isAllowedTransferRequestStatus(request.resource.data.status) &&
        request.resource.data.requestType in ['physical', 'digital'] &&
        isValidTransferRequestTransition(resource.data.status, request.resource.data.status) &&
        (
          request.resource.data.requestType != 'digital' ||
          request.resource.data.status in ['pending', 'approved', 'rejected', 'completed']
        ) &&
        (
          request.resource.data.requestType != 'physical' ||
          request.resource.data.status in ['pending', 'approved', 'rejected', 'dispatched', 'received', 'returned']
        );
    }

    // الحقول المسموحة في سجل التحويلات (Chain of Custody)
    function transferAllowedKeys(keys) {
      return keys.hasOnly([
        'requestId',
        'requestType',
        'clientFileId', 'fileNumber',
        'action',
        'fromDepartment', 'toDepartment',
        'status',
        'shareToken', 'shareUrl',
        'notes',
        'actorId', 'actorName', 'actorEmail',
        'timestamp', 'createdAt'
      ]);
    }

    function sharedLinkAllowedKeys(keys) {
      return keys.hasOnly([
        'requestId', 'requestType',
        'clientFileId', 'fileNumber',
        'documentId', 'documentTitle', 'documentCategory',
        'contentType', 'filePath', 'downloadURL',
        'toDepartment', 'bankName',
        'viewOnly', 'allowDownload', 'allowPrint', 'allowEdit',
        'watermarkEnabled',
        'active',
        'createdBy', 'createdByName', 'createdAt',
        'expiresAt',
        'lastAccessAt', 'accessCount'
      ]);
    }

    function isAllowedTransferAction(value) {
      return value in ['dispatch', 'receive', 'return', 'digital_share'];
    }

    function isAllowedTransferStatus(value) {
      return value in ['in_transit', 'received', 'returned', 'completed'];
    }

    // الحقول المسموحة في سجل النشاط
    function activityAllowedKeys(keys) {
      // السماح بالحقلـات المستخدمة فعلياً بواسطة نظام التسجيل الأمامي
      // ActivityLogger يرسل: id, timestamp, sessionId, userId, userEmail, userDisplayName,
      // category, action, details, priority, synced, syncedAt
      // كما أن بعض عمليات اللوحة تستخدم الحقول: targetType, targetId, performedBy
      return keys.hasOnly([
        'id',
        'timestamp',
        'sessionId',
        'userId',
        'userEmail',
        'userDisplayName',
        'category',
        'action',
        'eventType',
        'severity',
        'entityType',
        'entityId',
        'outcome',
        'details',
        'priority',
        'synced',
        'syncedAt',
        'targetType',
        'targetId',
        'performedBy'
      ]);
    }

    // الحقول المسموحة في سجل التدقيق الإداري
    function auditLogAllowedKeys(keys) {
      return keys.hasOnly([
        'action',
        'targetType',
        'targetId',
        'details',
        'timestamp',
        'performedBy',
        'reason',
        'securityReauthAt'
      ]);
    }

    // الحقول المسموحة في سجل أحداث المصادقة
    function authLogAllowedKeys(keys) {
      return keys.hasOnly([
        'eventType',
        'uid',
        'email',
        'error',
        'attempts',
        'ip',
        'userAgent',
        'timestamp',
        'registrationType',
        'department',
        'needsApproval'
      ]);
    }

    // الحقول المسموحة في الإشعار
    function notificationAllowedKeys(keys) {
      return keys.hasOnly(['userId', 'title', 'body', 'createdAt', 'read', 'type']);
    }

    // الحقول المسموحة في تفضيلات المستخدم (مستوى علوي فقط)
    function userPreferencesAllowedKeys(keys) {
      return keys.hasOnly(['channels', 'frequency', 'types', 'quietHours']);
    }

    // منع تعديل createdAt بعد الإنشاء وحماية المالك
    function createdAtImmutableOnUpdate() {
      return !(('createdAt' in request.resource.data) && (request.resource.data.createdAt != resource.data.createdAt));
    }

    // الحفاظ على createdBy ثابتة
    function createdByImmutableOnUpdate() {
      return !(('createdBy' in request.resource.data) && (request.resource.data.createdBy != resource.data.createdBy));
    }

    // Users collection
    match /users/{userId} {
      // قراءة جميع المستخدمين للمصادقين فقط (قد تفكر لاحقاً بتقييد أكثر)
      allow read: if isAuthenticated();

      // إنشاء مستخدم
      // 1) إداري يمكنه الإنشاء
      // 2) تمكين إنشاء ذاتي مبدئي لمستند المستخدم (Bootstrap) للبريد الموثوق من نطاق المؤسسة
      allow create: if (
        (
          isAdmin() &&
          userAllowedKeys(request.resource.data.keys()) &&
          isAllowedRole(request.resource.data.role)
        )
        ||
        (
          isAuthenticated() &&
          request.auth.uid == userId &&
          // السماح للمستخدم بإنشاء مستنده الأول بذاته إذا كان بريده من نطاق المؤسسة
          // ملاحظة: يمكن ضبط النطاق حسب الحاجة
          request.auth.token.email.matches('.*@aman\\.eg') &&
          userAllowedKeys(request.resource.data.keys()) &&
          // الدور اختياري عند الإنشاء الذاتي؛ إن وُجد يجب أن يكون مسموحاً
          (!('role' in request.resource.data) || isAllowedRole(request.resource.data.role))
        )
      );

      // تحديث: المالك يمكنه تعديل بياناته (باستثناء الدور)؛ الإداري حر ضمن الحدود
      allow update: if isOwnerOrAdmin(userId) &&
        userAllowedKeys(request.resource.data.keys()) &&
        roleNotElevatedOnUserUpdate() &&
        createdAtImmutableOnUpdate() &&
        createdByImmutableOnUpdate();

      // حذف: إداري فقط
      allow delete: if isAdmin();
    }

    // Documents collection
    match /documents/{documentId} {
      allow read: if isAuthenticated() && (
        // إداري أو موظف أرشيف
        isAdmin() || isArchiveOfficer() ||
        // المنشئ يمكنه القراءة دائماً
        resource.data.createdBy == request.auth.uid ||
        // تقييد القراءة حسب القسم الحالي للوثيقة
        (
          // تطبيع اسم قسم المستخدم إلى معرف (فرضاً مخزن في users.department أو users.departmentId)
          // ملاحظة: لا يمكننا استدعاء دالة تطبيع معقدة هنا؛ نفترض أن القيمة مخزنة بشكل متسق
          resource.data.currentDepartment == currentUserDoc().data.department ||
          resource.data.currentDepartment == currentUserDoc().data.departmentId ||
          // دعم قديم: بعض الوثائق تستخدم الحقل department فقط
          resource.data.department == currentUserDoc().data.department ||
          resource.data.department == currentUserDoc().data.departmentId
        )
      );

      // ملاحظة: في create يجب استخدام request.resource وليس resource
      allow create: if isAuthenticated() &&
        documentAllowedKeys(request.resource.data.keys()) &&
        request.resource.data.createdBy == request.auth.uid &&
        (isAdmin() || isArchiveOfficer() || true); // السماح للمستخدم بإنشاء مستند يخصه

      allow update: if isAuthenticated() &&
        documentAllowedKeys(request.resource.data.keys()) &&
        (isAdmin() || isArchiveOfficer() || resource.data.createdBy == request.auth.uid) &&
        createdAtImmutableOnUpdate() &&
        createdByImmutableOnUpdate();

      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.createdBy == request.auth.uid);
    }

    // Clients collection
    match /clients/{clientDocId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        clientAllowedKeys(request.resource.data.keys()) &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() &&
        clientAllowedKeys(request.resource.data.keys()) &&
        (isAdmin() || isArchiveOfficer() || resource.data.createdBy == request.auth.uid) &&
        createdAtImmutableOnUpdate() &&
        createdByImmutableOnUpdate();
      allow delete: if isAdmin();
    }

    // Client files collection
    match /client_files/{clientFileId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        clientFileAllowedKeys(request.resource.data.keys()) &&
        isValidClientFileCreateState() &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() &&
        clientFileAllowedKeys(request.resource.data.keys()) &&
        isValidClientFileUpdateState() &&
        (isAdmin() || isArchiveOfficer() || resource.data.createdBy == request.auth.uid) &&
        createdAtImmutableOnUpdate() &&
        createdByImmutableOnUpdate();
      allow delete: if isAdmin();
    }

    // Transfer requests collection
    match /transfer_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        transferRequestAllowedKeys(request.resource.data.keys()) &&
        isValidTransferRequestStateOnCreate() &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuthenticated() &&
        transferRequestAllowedKeys(request.resource.data.keys()) &&
        isValidTransferRequestStateOnUpdate() &&
        (
          isWorkflowReviewer() ||
          (resource.data.createdBy == request.auth.uid && transferRequestStatusUnchanged())
        ) &&
        createdAtImmutableOnUpdate() &&
        createdByImmutableOnUpdate();
      allow delete: if isAdmin();
    }

    // Transfers collection (chain of custody)
    match /transfers/{transferId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        transferAllowedKeys(request.resource.data.keys()) &&
        isAllowedTransferAction(request.resource.data.action) &&
        isAllowedTransferStatus(request.resource.data.status) &&
        request.resource.data.actorId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Shared links collection for secure digital viewer
    match /shared_links/{linkId} {
      // السماح بالقراءة العامة فقط للروابط المفعلة وغير المنتهية وبوضع العرض فقط
      allow read: if (
        resource.data.active == true &&
        resource.data.viewOnly == true &&
        resource.data.expiresAt != null &&
        resource.data.expiresAt > request.time
      ) || (
        isAuthenticated() && (isAdmin() || isArchiveOfficer())
      );

      // الإنشاء/التعديل: إداري أو موظف أرشيف أو مسؤول إدارة قسم
      allow create, update: if isAuthenticated() && (
        sharedLinkAllowedKeys(request.resource.data.keys()) &&
        isWorkflowReviewer()
      );

      // الحذف: إداري فقط
      allow delete: if isAdmin();
    }

    // File movements collection
    match /file_movements/{movementId} {
      allow read: if isAuthenticated();
      // إنشاء حركة ملف: يسمح لأي مستخدم مصادق بإنشاء سجل حركة يخصه (أو إداري)
      allow create: if isAuthenticated() &&
        movementAllowedKeys(request.resource.data.keys()) &&
        (request.resource.data.userId == request.auth.uid || isAdmin() || isArchiveOfficer());
      // غالباً لا نحتاج تحديث حركة بعد إنشائها؛ السماح فقط للإداري
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Activity logs collection
    match /activity_logs/{logId} {
      allow read: if isAuthenticated() &&
        (isAdmin() || resource.data.userId == request.auth.uid);
      // إنشاء سجل نشاط: يجب أن يكون userId هو نفس المستخدم (أو إداري يكتب عن مستخدم آخر)
      allow create: if isAuthenticated() &&
        activityAllowedKeys(request.resource.data.keys()) &&
        (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if false; // لا يسمح بتعديل السجلات
      allow delete: if false; // write-once: لا يسمح بحذف السجلات
    }

    // Audit logs collection (write-once)
    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.performedBy == request.auth.uid);
      allow create: if isAuthenticated() &&
        auditLogAllowedKeys(request.resource.data.keys()) &&
        (request.resource.data.performedBy == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    // Auth logs collection (write-once)
    match /auth_logs/{logId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.uid != null && resource.data.uid == request.auth.uid) ||
        (resource.data.email != null && request.auth.token.email != null && resource.data.email == request.auth.token.email)
      );
      allow create: if isAuthenticated() &&
        authLogAllowedKeys(request.resource.data.keys()) &&
        (
          isAdmin() ||
          (
            (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid) &&
            (!('email' in request.resource.data) || (request.auth.token.email != null && request.resource.data.email == request.auth.token.email))
          )
        );
      allow update, delete: if false;
    }

    // Departments collection
    match /departments/{departmentId} {
      // Allow public read so unauthenticated users (registration page) can load departments list
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // System settings collection
    match /system_settings/{settingId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isSuperAdmin() || isTrustedAdminBootstrap();
    }

    // Invitations collection
    match /invitations/{invitationId} {
      // Allow read for active, non-expired invitations to enable public invite code verification
      allow read: if isAuthenticated() || (
        resource.data.status == 'active' &&
        resource.data.expiresAt != null &&
        resource.data.expiresAt > request.time
      );
      allow create, update, delete: if isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      // إنشاء إشعار: لا يُسمح لمستخدم عادي بإنشاء إشعار لغيره
      allow create: if isAuthenticated() &&
        notificationAllowedKeys(request.resource.data.keys()) &&
        (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        // السماح للمستخدم بتحديث حقل read فقط
        request.resource.data.keys().hasOnly(['userId','title','body','createdAt','read','type']) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.title == resource.data.title &&
        request.resource.data.body == resource.data.body &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.type == resource.data.type;
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // User preferences collection: يسمح لكل مستخدم بقراءة/حفظ تفضيلاته الخاصة فقط
    match /user_preferences/{userId} {
      allow read: if isAuthenticated() && userId == request.auth.uid;
      allow create, update: if isAuthenticated() &&
        userId == request.auth.uid &&
        userPreferencesAllowedKeys(request.resource.data.keys());
      // حذف التفضيلات: المالك أو إداري
      allow delete: if isAuthenticated() && (userId == request.auth.uid || isAdmin());
    }

    // Notification queue: إنشاء فقط من العملاء المصادقين، وإدارة كاملة للإداري
    match /notification_queue/{queueId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // Sent notifications: إنشاء من العميل/الخدمة، قراءة للمالك أو إداري
    match /sent_notifications/{sentId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() &&
        (resource.data.recipientId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // User page permissions overrides collection
    match /user_page_permissions/{userId} {
      // القراءة: المالك أو إداري
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin() || isTrustedAdminBootstrap());
      // الإنشاء/التحديث/الحذف: إداري فقط (منع المستخدم من تعديل تخصيصه مباشرة)
      // السماح أيضاً لمدراء التمهيد الموثوقين (bootstrap) بالكتابة لتجاوز مشكلة تهيئة الدور الأولى
      allow create, update, delete: if isAdmin() || isTrustedAdminBootstrap();
    }
  }
}