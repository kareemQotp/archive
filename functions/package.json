{
  "name": "archive-system-functions",
  "description": "Firebase Cloud Functions for Archive System",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint src --ext .js,.ts",
  "test": "npm run test:full",
  "test:fast": "jest __tests__/lint-rule.spec.js test/rateLimit.test.js test/smoke/healthCheck.smoke.test.js --runInBand",
  "test:lint-rule": "jest __tests__/lint-rule.spec.js --runInBand",
  "test:full": "jest --runInBand",
    "test:integration": "powershell -ExecutionPolicy Bypass -File scripts/run-integration.ps1",
    "emulators": "firebase emulators:start --import ./emulator-data --export-on-exit",
    "seed": "node scripts/seed-emulator.js"
  },
  "engines": {
    "node": "18"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "typescript": "^4.9.0",
    "eslint-plugin-local-firestore": "file:./eslint-rules",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
  "eslint-plugin-import": "^2.25.4",
  "jest": "^29.7.0",
  "ts-jest": "^29.1.2",
    "firebase-functions-test": "^3.1.0",
    "firebase-tools": "^13.0.0",
    "cross-env": "^7.0.3"
  },
  "private": true
}
